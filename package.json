{
  "name": "haloflux-universal",
  "version": "0.1.0",
  "private": true,
  "description": "HALOFLUX Universal Agent Visualizer — one visual engine for DeepSeek Harness, Codex, Cursor, WorkBuddy, Claude Code and TRAE.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "packages/*",
    "adapters/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @haloflux/event-schema",
    "typecheck": "tsc -p packages/event-schema/tsconfig.json --noEmit",
    "bridge": "node packages/event-bridge/src/server.mjs",
    "companion": "node scripts/launch-companion.mjs",
    "simulate": "node packages/event-bridge/src/simulator.mjs",
    "status": "node scripts/haloflux.mjs status",
    "doctor": "node scripts/haloflux.mjs doctor",
    "install:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "test:security": "node --test \"tests/security/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
